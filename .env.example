# Copy this file to .env in the same folder and fill in the values.
# .env is git-ignored. Never commit it.
ANTHROPIC_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
TAVILY_API_KEY=
GUARDIAN_API_KEY=
# Monitor the Situation's /v1 feed (the events a video starts from)
MTS_API_KEY=
# OpenRouter: the script writer (module 7) runs on it, so every video needs this key
OPENROUTER_API_KEY=
# ElevenLabs, the narrator voice (module 8; Starter plan)
ELEVENLABS_API_KEY=
